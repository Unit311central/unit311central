{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "env": {
    "NEXT_PUBLIC_SAEC_DISCOVERY_REQUIRE_AUTH": "true"
  },
  "crons": [
    {
      "path": "/api/cron/founder-session-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/crm-client-report-followups",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/wise-payment-reconcile",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/competitor-intelligence-weekly",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/software-billing-sync",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/apply-sales-management-foundation",
      "schedule": "*/5 * * * *"
    }
  ]
}
